[Unit]
Description=RMS dashboard@DESC_SUFFIX@: live tonight capture preview builder
After=@CAPTURE_SERVICE@.service network-online.target
Wants=network-online.target
@MOUNT_LINE@

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=-@ENV_FILE@
ExecStart=@VENV_PY@ @REPO_DIR@/make_tonight_preview.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
