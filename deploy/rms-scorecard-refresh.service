[Unit]
Description=Refresh RMS dashboard@DESC_SUFFIX@ neighbours scorecard (you vs nearby GMN stations)
After=network-online.target
Wants=network-online.target
@MOUNT_LINE@

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=-@ENV_FILE@
ExecStart=/usr/bin/python3 @REPO_DIR@/make_scorecard.py
