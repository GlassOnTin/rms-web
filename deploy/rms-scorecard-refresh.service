[Unit]
Description=Refresh RMS dashboard neighbours scorecard (you vs nearby GMN stations)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/nvme/RMS_data

[Service]
Type=oneshot
User=ian
Group=ian
WorkingDirectory=/home/ian/source/rms-web
ExecStart=/usr/bin/python3 /home/ian/source/rms-web/make_scorecard.py
