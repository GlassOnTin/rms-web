[Unit]
Description=Refresh RMS dashboard@DESC_SUFFIX@ neighbours map (GMN station list + render)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=-@ENV_FILE@
ExecStart=@VENV_PY@ @REPO_DIR@/make_neighbours_map.py --refresh
