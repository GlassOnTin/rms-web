[Unit]
Description=RMS local web dashboard@DESC_SUFFIX@ (read-only, LAN only)
After=network-online.target
Wants=network-online.target
@MOUNT_LINE@

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=-@ENV_FILE@
ExecStart=/usr/bin/python3 @REPO_DIR@/rms_web.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
